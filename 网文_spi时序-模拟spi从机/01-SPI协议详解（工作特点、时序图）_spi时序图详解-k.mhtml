body { background-color: rgb(247, 247, 247); color: rgb(100, 100, 100); }

body.safe-browsing { background-color: rgb(206, 52, 38); color: white; }

button { user-select: none; background: rgb(66, 133, 244); border: 0px; bor=
der-radius: 2px; box-sizing: border-box; color: rgb(255, 255, 255); cursor:=
 pointer; float: right; font-size: 0.875em; margin: 0px; padding: 10px 24px=
; transition: box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1) 0s; }

[dir=3D"rtl"] button { float: left; }

button:active { background: rgb(50, 102, 213); outline: 0px; }

button:hover { box-shadow: rgba(0, 0, 0, 0.5) 0px 1px 3px; }

#debugging { display: inline; overflow: auto; }

.debugging-content { line-height: 1em; margin-bottom: 0px; margin-top: 1em;=
 }

.debugging-title { font-weight: bold; }

#details { color: rgb(105, 105, 105); margin: 45px 0px 50px; }

#details p:not(:first-of-type) { margin-top: 20px; }

#details-button { background: inherit; border: 0px; float: none; margin: 0p=
x; padding: 10px 0px; text-transform: uppercase; }

#details-button:hover { box-shadow: inherit; text-decoration: underline; }

.error-code { color: rgb(105, 105, 105); display: inline; font-size: 0.8666=
7em; margin-top: 15px; opacity: 0.5; text-transform: uppercase; }

#error-debugging-info { font-size: 0.8em; }

h1 { color: rgb(51, 51, 51); font-size: 1.6em; font-weight: normal; line-he=
ight: 1.25em; margin-bottom: 16px; }

h2 { font-size: 1.2em; font-weight: normal; }

.hidden { display: none; }

html { text-size-adjust: 100%; font-size: 125%; }

.icon { background-repeat: no-repeat; background-size: 100%; height: 72px; =
margin: 0px 0px 40px; width: 72px; }

input[type=3D"checkbox"] { opacity: 0; }

input[type=3D"checkbox"]:focus ~ .checkbox { outline: -webkit-focus-ring-co=
lor auto 5px; }

.interstitial-wrapper { box-sizing: border-box; font-size: 1em; line-height=
: 1.6em; margin: 100px auto 0px; max-width: 600px; width: 100%; }

#main-message > p { display: inline; }

#extended-reporting-opt-in { font-size: 0.875em; margin-top: 39px; }

#extended-reporting-opt-in label { position: relative; }

.nav-wrapper { margin-top: 51px; }

.nav-wrapper::after { clear: both; content: ""; display: table; width: 100%=
; }

.safe-browsing :-webkit-any(a, #details, #details-button, h1, h2, p, .small=
-link) { color: white; }

.safe-browsing button { background-color: rgba(255, 255, 255, 0.15); }

.safe-browsing button:active { background-color: rgba(255, 255, 255, 0.25);=
 }

.safe-browsing button:hover { box-shadow: rgba(0, 0, 0, 0.5) 0px 2px 3px; }

.safe-browsing .error-code { display: none; }

